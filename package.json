{
  "name": "policybias",
  "version": "0.0.0",
  "private": true,
  "description": "Guess the party from the policy, not the colour.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "predev": "pnpm build:cards",
    "prebuild": "pnpm build:cards",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build:cards": "tsx scripts/build-cards.ts",
    "check:policy": "tsx scripts/check-policy.ts",
    "check:policy:nz": "tsx scripts/check-policy.ts --event nz-election-2026",
    "check:policy:se": "tsx scripts/check-policy.ts --event se-election-2026",
    "dump:party-policy": "tsx scripts/dump.ts",
    "dump:harvest": "tsx scripts/harvest.ts",
    "translate:specs": "tsx scripts/translate-specs.ts",
    "lint:specs": "gurki lint corpus/nz-election-2026 corpus/se-election-2026",
    "gurki": "gurki"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "gurki": "github:danalexilewis/gurki",
    "nuqs": "^2.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@serwist/vite": "^9.5.12",
    "@serwist/window": "^9.5.12",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.5.2",
    "cheerio": "^1.1.2",
    "crawlee": "^3.18.1",
    "jsdom": "^30.0.1",
    "serwist": "^9.5.12",
    "tsx": "^4.20.3",
    "turndown": "^7.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}